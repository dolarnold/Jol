<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Universal Links: shared event links (https://…/e/CODE) open in the app.
  Not switched on yet. To switch on (needs a Mac or Codemagic signing):
  1. developer.apple.com → Identifiers → the JOL app ID → tick "Associated Domains".
  2. Xcode → Runner → Signing & Capabilities → + Capability → Associated Domains
     (Xcode then points the Runner target at this file), or set
     CODE_SIGN_ENTITLEMENTS = Runner/Runner.entitlements for the Runner target.
  3. Add the Apple Team ID and bundle ID in Admin → Integrations → App links.
  Add another "applinks:" line when JOL gets its own domain.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:jolnow.co.za</string>
		<string>applinks:www.jolnow.co.za</string>
		<string>applinks:jol-backend-production-xgp5ka.laravel.cloud</string>
	</array>
</dict>
</plist>
